{
  "pluginAlias": "TpLinkPowerline",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "TP-Link Powerline"
      },
      "devices": {
        "title": "Devices",
        "type": "array",
        "uniqueItems": true,
        "items": {
          "title": "Device",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "placeholder": "TP-Link Powerline"
            },
            "mac": {
              "title": "MAC Address",
              "type": "string",
              "pattern": "^([A-Fa-f0-9]{2}:){5}[A-Fa-f0-9]{2}$",
              "required": true
            },
            "serialNumber": {
              "title": "Serial Number",
              "type": "string"
            },
            "model": {
              "title": "Model",
              "type": "string"
            },
            "pollInterval": {
              "title": "Poll Interval (ms)",
              "type": "integer",
              "default": 10000,
              "minimum": 1000,
              "description": "How often (in milliseconds) to ping the device and update its status. Minimum 1000ms. Default 10000ms."
            }
          }
        }
      }
    }
  }
}
